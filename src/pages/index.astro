---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Signature from '../components/Signature.astro';
import Cuisine from '../components/Cuisine.astro';
import MenuSection from '../components/MenuSection.astro';
import About from '../components/About.astro';
import Access from '../components/Access.astro';
import Footer from '../components/Footer.astro';
import { site, restaurantSchema } from '../data/site';
import '../styles/global.css';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#211b17" />
    <meta name="description" content={site.description} />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <link rel="icon" href="/asian-star.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Noto+Sans+JP:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{site.title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(restaurantSchema).replace(/</g, '\\u003c')} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <main id="main"><Hero /><Signature /><Cuisine /><MenuSection /><About /><Access /></main>
    <Footer />
    <script>import '../scripts/site';</script>
  </body>
</html>
